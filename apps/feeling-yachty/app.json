{
  "expo": {
    "name": "Feeling Yachty",
    "slug": "feeling-yachty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#12263a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feelingyachty.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12263a"
      },
      "package": "com.feelingyachty.app",
      "permissions": ["INTERNET"],
      "usesCleartextTraffic": false
    },
    "plugins": [],
    "extra": {
      "apiBase": "https://feelingyachty.com"
    }
  }
}

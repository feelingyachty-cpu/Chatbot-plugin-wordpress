{
  "expo": {
    "name": "Feeling Yachty",
    "slug": "feeling-yachty",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#12263a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feelingyachty.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12263a"
      },
      "package": "com.feelingyachty.app",
      "permissions": ["INTERNET", "READ_MEDIA_IMAGES", "READ_EXTERNAL_STORAGE"],
      "usesCleartextTraffic": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Feeling Yachty uses your photos so you can set a profile picture on your charter account."
        }
      ]
    ],
    "extra": {
      "apiBase": "https://feelingyachty.com"
    }
  }
}
